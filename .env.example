# Copy to .env.local and fill in. Never commit real keys.
# Browser Maps key: Maps JavaScript API + Places API only (no Directions).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Stripe publishable key (pk_test_... for local/stage, pk_live_... only in Vercel Production).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_2=
# Optional: backend API address. Leave empty to use the default (see utilities/URL.js):
# production API on Vercel Production, staging API everywhere else.
# Example for a local backend: NEXT_PUBLIC_API_URL=http://localhost:3010/
NEXT_PUBLIC_API_URL=
