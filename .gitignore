# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local secrets — never commit real keys. Example templates are OK.
.env
.env.*
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# Local backup copies made during the 2026 redesign (old versions of changed files).
# They are not used by the app; git history keeps the real record of the old code.
/src/legacy/

# typescript
*.tsbuildinfo
next-env.d.ts
